<Page x:Class="Echo_Windows.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="using:Echo_Windows.Core" xmlns:local="using:Echo_Windows" Background="{ThemeResource EchoCanvasBrush}">
 <Page.Resources>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
  <Style x:Key="LanguageMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,3"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="30"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
  <Style x:Key="SubtitleActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4,2"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="30"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
  <Style x:Key="CompactToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Padding" Value="9,4"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style x:Key="StopRecordingButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}"/><Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,4"/><Setter Property="MinHeight" Value="34"/><Setter Property="MinWidth" Value="126"/></Style>
  <Style x:Key="SettingCard" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="20"/></Style>
 </Page.Resources>
 <Grid>
  <Grid x:Name="RecordingPanel" Margin="20" RowSpacing="18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <TextBlock Text="ECHO" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource EchoAccentBrush}" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
     <Button x:Name="SubtitleOverlayButton" Style="{StaticResource QuietButton}" Width="36" Height="36" Padding="8" ToolTipService.ToolTip="悬浮字幕" AutomationProperties.Name="悬浮字幕" AutomationProperties.AutomationId="SubtitleOverlayMenu"><FontIcon Glyph="&#xE7F4;" FontSize="16"/><Button.Flyout><MenuFlyout><MenuFlyoutItem x:Name="ToggleOverlayMenuItem" Text="开启悬浮字幕" Click="ToggleOverlay_Click" AutomationProperties.AutomationId="ToggleSubtitleOverlay"/><MenuFlyoutItem x:Name="AdjustOverlayMenuItem" Text="调整位置和大小" Click="AdjustOverlay_Click" AutomationProperties.AutomationId="AdjustSubtitleOverlay"/><MenuFlyoutItem x:Name="LockOverlayMenuItem" Text="解锁位置" Click="ToggleOverlayLock_Click" AutomationProperties.AutomationId="ToggleSubtitleOverlayLock"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="悬浮字幕设置…" Click="OverlaySettings_Click" AutomationProperties.AutomationId="SubtitleOverlaySettings"/></MenuFlyout></Button.Flyout></Button>
     <Button x:Name="SettingsButton" Click="Settings_Click" Style="{StaticResource QuietButton}" Width="36" Height="36" Padding="8" ToolTipService.ToolTip="服务设置" AutomationProperties.Name="服务设置" AutomationProperties.AutomationId="SettingsTab"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button>
     <Button Click="CycleTheme_Click" Style="{StaticResource QuietButton}" Width="36" Height="36" Padding="8" ToolTipService.ToolTip="切换浅色、深色或系统主题" AutomationProperties.Name="切换主题" AutomationProperties.AutomationId="CycleTheme"><FontIcon Glyph="&#xE706;" FontSize="16"/></Button>
     <ToggleButton Checked="Topmost_Toggled" Unchecked="Topmost_Toggled" Background="Transparent" BorderThickness="0" Width="36" Height="36" ToolTipService.ToolTip="窗口置顶" AutomationProperties.Name="窗口置顶" AutomationProperties.AutomationId="Topmost"><FontIcon Glyph="&#xE718;" FontSize="16"/></ToggleButton>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" RowSpacing="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button x:Name="SourceLanguageChoice" Style="{StaticResource LanguageMenuButtonStyle}" ToolTipService.ToolTip="选择识别语言" AutomationProperties.Name="识别语言" AutomationProperties.AutomationId="SourceLanguageChoice"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock x:Name="SourceLanguageTitle" Text="自动识别" FontSize="14" FontWeight="SemiBold"/><FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/></StackPanel><Button.Flyout><MenuFlyout x:Name="SourceLanguageFlyout"/></Button.Flyout></Button>
    <Button x:Name="TargetLanguageChoice" Grid.Column="1" Style="{StaticResource LanguageMenuButtonStyle}" ToolTipService.ToolTip="选择翻译目标语言" AutomationProperties.Name="翻译目标：不翻译" AutomationProperties.AutomationId="TargetLanguageChoice"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock x:Name="TargetLanguageTitle" Text="不翻译" FontSize="14" FontWeight="SemiBold"/><FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/></StackPanel><Button.Flyout><MenuFlyout x:Name="TargetLanguageFlyout"/></Button.Flyout></Button>
   </Grid><TextBlock Grid.Row="1" x:Name="LanguageNextSessionHint" Text="录音中更改语言：下次录音生效" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed"/>
   </Grid>
    <Grid Grid.Row="2">
    <Border Height="1" VerticalAlignment="Top" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.55" IsHitTestVisible="False"/>
    <TextBlock x:Name="EmptyHint" Text="开始录音后，每条识别结果会保留在这里" VerticalAlignment="Top" Padding="0,14,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <ListView x:Name="TranscriptList" ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}" SelectionMode="None" Background="Transparent" BorderThickness="0" AutomationProperties.Name="双语字幕记录" AutomationProperties.AutomationId="TranscriptList" Padding="0,8,0,12">
     <ListView.ItemTemplate><DataTemplate x:DataType="core:Subtitle">
      <Grid Padding="0,6" RowSpacing="4" ColumnSpacing="14" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{x:Bind DateSeparatorLabel, Mode=OneWay}" Visibility="{x:Bind local:MainPage.VisibleWhen(HasDateSeparator), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,12,0,4" AutomationProperties.HeadingLevel="Level2"/>
       <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="7"><TextBlock Text="{x:Bind Speaker, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="·" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw"/><TextBlock Text="{x:Bind TimeLabel, Mode=OneWay}" FontSize="12" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind Language, Mode=OneWay}" Visibility="{x:Bind local:MainPage.VisibleWhen(HasLanguage), Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.Name="{x:Bind local:MainPage.AccessibleText('检测语言', Language), Mode=OneWay}"/><TextBlock Text="已纠正" Visibility="{x:Bind local:MainPage.VisibleWhen(HasCorrection), Mode=OneWay}" FontSize="12" Foreground="{ThemeResource EchoAccentBrush}"/></StackPanel>
       <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource SubtitleActionButtonStyle}" Click="Correction_Click" HorizontalAlignment="Right" ToolTipService.ToolTip="编辑原文和译文，不中断录音" AutomationProperties.Name="{x:Bind CorrectionLabel, Mode=OneWay}" AutomationProperties.AutomationId="{x:Bind local:MainPage.SubtitleEditAutomationId(Id), Mode=OneTime}"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE70F;" FontSize="12"/><TextBlock Text="{x:Bind CorrectionLabel, Mode=OneWay}" FontSize="12"/></StackPanel></Button>
       <TextBlock Grid.Row="2" Text="{x:Bind local:MainPage.TranscriptDisplayText(English, '…'), Mode=OneWay}" FontSize="15" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.Name="{x:Bind local:MainPage.AccessibleText('原文', English), Mode=OneWay}"/>
       <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind local:MainPage.TranscriptDisplayText(Chinese, ' '), Mode=OneWay}" FontSize="15" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.Name="{x:Bind local:MainPage.AccessibleText('译文', Chinese), Mode=OneWay}"/>
       <Border Grid.Row="3" Grid.ColumnSpan="2" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.55" Margin="0,6,0,0"/>
      </Grid>
     </DataTemplate></ListView.ItemTemplate>
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
    </ListView>
    <Button x:Name="NewContentButton" Content="有新内容  ↓" Click="Latest_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Visibility="Collapsed" Background="{ThemeResource EchoAccentBrush}" Foreground="{ThemeResource EchoAccentForegroundBrush}" AutomationProperties.AutomationId="ScrollToLatest"/>
   </Grid>
   <Grid Grid.Row="3" RowSpacing="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="Mode" Visibility="Collapsed" IsEnabled="{x:Bind ViewModel.CanChangeAudioMode, Mode=OneWay}" SelectionChanged="AudioMode_SelectionChanged"><x:String>电脑音频</x:String><x:String>麦克风</x:String><x:String>电脑音频和话筒</x:String></ComboBox>
     <Button x:Name="AudioModeButton" Style="{StaticResource CompactToolbarButtonStyle}" MinWidth="148" IsEnabled="{x:Bind ViewModel.CanChangeAudioMode, Mode=OneWay}" AutomationProperties.Name="音频来源" AutomationProperties.AutomationId="InputMode" ToolTipService.ToolTip="选择音频来源"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock x:Name="AudioModeTitle" Text="麦克风"/><FontIcon Glyph="&#xE70D;" FontSize="10"/></StackPanel><Button.Flyout><MenuFlyout x:Name="AudioModeFlyout"><MenuFlyoutItem Text="电脑音频" Tag="0" Click="AudioModeMenuItem_Click" AutomationProperties.AutomationId="InputModeComputer"/><MenuFlyoutItem Text="麦克风" Tag="1" Click="AudioModeMenuItem_Click" AutomationProperties.AutomationId="InputModeMicrophone"/><MenuFlyoutItem Text="电脑音频和话筒" Tag="2" Click="AudioModeMenuItem_Click" AutomationProperties.AutomationId="InputModeMixed"/></MenuFlyout></Button.Flyout></Button>
     <Button Grid.Column="1" Click="Start_Click" Style="{StaticResource CompactToolbarButtonStyle}" MinWidth="126" MinHeight="34" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" Visibility="{x:Bind local:MainPage.HiddenWhen(ViewModel.IsRecording), Mode=OneWay}" Background="{ThemeResource EchoAccentBrush}" Foreground="{ThemeResource EchoAccentForegroundBrush}" AutomationProperties.AutomationId="StartRecording" AutomationProperties.Name="开始录音"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE720;" FontSize="14"/><TextBlock Text="开始录音"/></StackPanel></Button>
     <Button Grid.Column="1" Click="Stop_Click" Style="{StaticResource StopRecordingButtonStyle}" IsEnabled="{x:Bind ViewModel.CanStopRecording, Mode=OneWay}" Visibility="{x:Bind local:MainPage.VisibleWhen(ViewModel.IsRecording), Mode=OneWay}" AutomationProperties.AutomationId="StopRecording" AutomationProperties.Name="停止录音"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71A;" FontSize="12"/><TextBlock Text="停止录音"/></StackPanel></Button>
     <Button Grid.Column="2" Content="切换设备" Click="SwitchAudio_Click" Style="{StaticResource CompactToolbarButtonStyle}" Visibility="{x:Bind local:MainPage.VisibleWhen(ViewModel.IsRecording), Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanSwitchAudioDevices, Mode=OneWay}" AutomationProperties.AutomationId="SwitchAudioDevice"/>
     <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360" AutomationProperties.AutomationId="Status" AutomationProperties.Name="{x:Bind local:MainPage.AccessibleText('录音状态', ViewModel.Status), Mode=OneWay}" AutomationProperties.LiveSetting="Polite"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" AutomationProperties.AutomationId="ArchiveMenu" ToolTipService.ToolTip="选择或管理本地存档"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="14"/><TextBlock x:Name="ArchiveTitle" Text="新的录音" MaxWidth="240" TextTrimming="CharacterEllipsis"/><FontIcon Glyph="&#xE70D;" FontSize="10"/></StackPanel>
       <Button.Flyout><Flyout x:Name="ArchiveFlyout" Placement="TopEdgeAlignedLeft"><Grid Width="300" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="本地存档" Style="{StaticResource SubtitleTextBlockStyle}"/><Button Content="新建" Click="New_Click" HorizontalAlignment="Right" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="ArchiveNew"/></Grid><ListView Grid.Row="1" MaxHeight="300" MinHeight="80" ItemsSource="{x:Bind ViewModel.Archives, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedArchive, Mode=TwoWay}" DisplayMemberPath="Title" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="ArchiveList" AutomationProperties.Name="本地存档"/><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button Content="重命名" Click="RenameArchive_Click" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="RenameArchive"/><Button Content="导入存档" Click="Import_Click" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="ArchiveImport"/><Button Content="数据目录" Click="Folder_Click" AutomationProperties.AutomationId="OpenDataFolder"/></StackPanel></Grid></Flyout></Button.Flyout>
     </Button>
     <Button Grid.Column="1" Content="导出" AutomationProperties.AutomationId="ExportMenu"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="SRT 字幕" Click="ExportSrt_Click" AutomationProperties.AutomationId="ExportSrt"/><MenuFlyoutItem Text="Echo 存档" Click="ExportArchive_Click" AutomationProperties.AutomationId="ExportArchive"/></MenuFlyout></Button.Flyout></Button>
     <Button Grid.Column="2" Content="更多" AutomationProperties.AutomationId="MoreMenu"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="新建存档" Click="New_Click" AutomationProperties.AutomationId="MoreNew"/><MenuFlyoutItem Text="导入存档" Click="Import_Click" AutomationProperties.AutomationId="MoreImport"/><MenuFlyoutItem Text="拆出刚完成的录音段" Click="SplitSegment_Click" IsEnabled="{x:Bind ViewModel.CanSplitCompletedSegment, Mode=OneWay}" AutomationProperties.AutomationId="SplitCompletedSegment"/><MenuFlyoutItem Text="移入回收区" Click="DeleteArchive_Click" IsEnabled="{x:Bind ViewModel.CanDeleteSelectedArchive, Mode=OneWay}" AutomationProperties.AutomationId="DeleteArchive"/><MenuFlyoutItem Text="打开数据目录" Click="Folder_Click" AutomationProperties.AutomationId="MoreFolder"/></MenuFlyout></Button.Flyout></Button>
    </Grid>
    <Grid Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Background="{ThemeResource EchoSubtleSurfaceBrush}" CornerRadius="10" Height="52" Padding="12,0"><StackPanel x:Name="WaveformBars" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/></Border>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" MinWidth="112" VerticalAlignment="Center"><Ellipse x:Name="AudioDot" Width="8" Height="8" Fill="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="AudioStatus" Text="未在录音" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
    </Grid>
   </Grid>
   <Border Grid.Row="4" Background="{ThemeResource EchoSubtleSurfaceBrush}" CornerRadius="10" Padding="12" Visibility="{x:Bind local:MainPage.VisibleWhen(ViewModel.IsSummaryPanelVisible), Mode=OneWay}">
    <Grid x:Name="SummarySection" RowSpacing="8" AutomationProperties.Name="AI 总结" AutomationProperties.AutomationId="SummarySection">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Grid.Row="0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE734;" FontSize="14" Foreground="{ThemeResource EchoAccentBrush}"/><TextBlock Text="AI 总结" FontSize="14" FontWeight="SemiBold"/></StackPanel>
      <TextBlock x:Name="SummaryRecordingHint" Grid.Column="1" Text="录音中，可随时生成" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed"/>
      <Button Grid.Column="2" Content="总结" Style="{StaticResource QuietButton}" Padding="4,2" MinHeight="30" AutomationProperties.Name="总结选项" AutomationProperties.AutomationId="SummaryScope" IsEnabled="{x:Bind local:MainPage.Not(ViewModel.IsSummarizing), Mode=OneWay}"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="总结新内容" Tag="0" Click="SummaryMenuItem_Click" AutomationProperties.AutomationId="GenerateSummary"/><MenuFlyoutItem Text="重新总结当前录音段" Tag="1" Click="SummaryMenuItem_Click" AutomationProperties.AutomationId="SummaryCurrentSegment"/><MenuFlyoutItem Text="总结整个存档" Tag="2" Click="SummaryMenuItem_Click" AutomationProperties.AutomationId="SummaryWholeArchive"/></MenuFlyout></Button.Flyout></Button>
     </Grid>
     <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.SummaryStatus, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
     <ScrollViewer x:Name="SummaryScrollViewer" Grid.Row="2" MaxHeight="220" Visibility="Collapsed"><StackPanel x:Name="SummaryBlocks" Spacing="7"/></ScrollViewer>
     <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind local:MainPage.VisibleWhen(ViewModel.HasGeneratedSummary), Mode=OneWay}"><Button x:Name="SummaryExpandButton" Content="展开全部" Click="SummaryExpand_Click" Style="{StaticResource QuietButton}" Padding="4,2" MinHeight="30" AutomationProperties.AutomationId="ExpandSummary"/><Button x:Name="SummaryCopyButton" Content="复制" Click="SummaryCopy_Click" Style="{StaticResource QuietButton}" Padding="4,2" MinHeight="30" AutomationProperties.AutomationId="CopySummary"/></StackPanel>
     <ComboBox x:Name="SummaryScope" Visibility="Collapsed" SelectedIndex="0"><x:String>新增内容</x:String><x:String>当前录音段</x:String><x:String>整个存档</x:String></ComboBox>
    </Grid>
   </Border>
  </Grid>
  <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="{ThemeResource EchoScrimBrush}" Canvas.ZIndex="10"><Border MaxWidth="520" MaxHeight="560" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="24" Background="{ThemeResource EchoCanvasBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"><Grid x:Name="SettingsPanel" RowSpacing="16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="BackSettingsButton" Click="Back_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="返回字幕" AutomationProperties.AutomationId="RecordingTab"><FontIcon Glyph="&#xE72B;" FontSize="16"/></Button><TextBlock Text="设置" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1"/></StackPanel><Button Content="完成" Click="SaveSettings_Click" Background="{ThemeResource EchoAccentBrush}" Foreground="{ThemeResource EchoAccentForegroundBrush}" HorizontalAlignment="Right" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="SaveSettings"/></Grid>
   <Grid Grid.Row="1" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <SelectorBar x:Name="SettingsSections" SelectionChanged="SettingsSections_SelectionChanged" AutomationProperties.AutomationId="SettingsSections">
     <SelectorBarItem x:Name="SettingsGeneral" Text="常规" AutomationProperties.AutomationId="SettingsGeneral"/><SelectorBarItem x:Name="SettingsRecognition" Text="识别" AutomationProperties.AutomationId="SettingsRecognition"/><SelectorBarItem x:Name="SettingsSegmentation" Text="分段" AutomationProperties.AutomationId="SettingsSegmentation"/><SelectorBarItem x:Name="SettingsServices" Text="AI 服务" AutomationProperties.AutomationId="SettingsServices"/>
    </SelectorBar>
    <ScrollViewer Grid.Row="1" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="SettingsScrollViewer"><StackPanel Spacing="12" Padding="0,0,12,8">
     <StackPanel x:Name="GeneralSettingsPage" Spacing="12">
      <TextBlock Text="音频与外观" FontWeight="SemiBold"/><ComboBox x:Name="OutputDevice" Header="电脑音频来源" ItemsSource="{x:Bind ViewModel.Outputs, Mode=OneWay}" HorizontalAlignment="Stretch" PlaceholderText="系统默认播放设备" AutomationProperties.AutomationId="OutputDevice"/><ComboBox x:Name="InputDevice" Header="麦克风" ItemsSource="{x:Bind ViewModel.Inputs, Mode=OneWay}" HorizontalAlignment="Stretch" PlaceholderText="系统默认麦克风" AutomationProperties.AutomationId="InputDevice"/><Button Content="刷新设备" Click="Refresh_Click" AutomationProperties.AutomationId="RefreshAudioDevices"/><ComboBox x:Name="ThemeChoice" Header="外观" SelectedIndex="1" SelectionChanged="ThemeChoice_SelectionChanged" AutomationProperties.AutomationId="ThemeChoice"><x:String>浅色</x:String><x:String>深色</x:String><x:String>跟随系统</x:String></ComboBox>
      <TextBlock Text="文件" FontWeight="SemiBold"/><TextBlock Text="字幕稿保存位置"/><TextBlock x:Name="TranscriptFolderPath" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource CaptionTextBlockStyle}"/><Button Content="打开保存位置" Click="Folder_Click" AutomationProperties.AutomationId="OpenTranscriptFolder"/><TextBlock Text="字幕稿保存在本机；原始音频默认不落盘。" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </StackPanel>
     <StackPanel x:Name="RecognitionSettingsPage" Spacing="12" Visibility="Collapsed">
      <TextBlock Text="识别与翻译" FontWeight="SemiBold"/><SelectorBar x:Name="SettingsSourceMode" SelectionChanged="SettingsSourceMode_SelectionChanged" AutomationProperties.AutomationId="SettingsSourceMode"><SelectorBarItem x:Name="AutomaticSourceMode" Text="自动识别" AutomationProperties.AutomationId="AutomaticSourceMode"/><SelectorBarItem x:Name="PreferredSourceMode" Text="优先语言" AutomationProperties.AutomationId="PreferredSourceMode"/></SelectorBar><StackPanel x:Name="PreferredSourceSettings" Spacing="8"><ComboBox x:Name="SettingsSourceLanguage" Header="优先语言" DisplayMemberPath="Title" AutomationProperties.AutomationId="SettingsSourceLanguage"/><ToggleSwitch x:Name="Strict" Header="仅识别此语言" AutomationProperties.AutomationId="StrictSourceLanguage"/><TextBlock Text="关闭时，优先语言只作为 Soniox 的识别提示。" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ComboBox x:Name="SettingsTargetLanguage" Header="翻译目标" DisplayMemberPath="Title" AutomationProperties.AutomationId="SettingsTargetLanguage"/><ToggleSwitch x:Name="Translate" Header="启用翻译" AutomationProperties.AutomationId="TranslationEnabled"/><ToggleSwitch x:Name="Speakers" Header="区分说话人" AutomationProperties.AutomationId="SpeakerLabelsEnabled"/><TextBlock Text="修改会在下一次建立 Soniox 会话时生效。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </StackPanel>
     <StackPanel x:Name="SegmentationSettingsPage" Spacing="12" Visibility="Collapsed">
      <TextBlock Text="字幕分段" FontWeight="SemiBold"/><TextBlock Text="服务端语义端点" FontWeight="SemiBold"/><Slider x:Name="EndpointDelay" Minimum="500" Maximum="3000" StepFrequency="50" AutomationProperties.Name="Soniox 最大端点延迟" AutomationProperties.AutomationId="EndpointDelay"/><TextBlock x:Name="EndpointDelayValue" Style="{StaticResource CaptionTextBlockStyle}"/><Slider x:Name="EndpointSensitivity" Minimum="-1" Maximum="1" StepFrequency="0.1" AutomationProperties.Name="Soniox 端点灵敏度" AutomationProperties.AutomationId="EndpointSensitivity"/><TextBlock x:Name="EndpointSensitivityValue" Style="{StaticResource CaptionTextBlockStyle}"/><Slider x:Name="EndpointLatency" Minimum="0" Maximum="3" StepFrequency="1" AutomationProperties.Name="Soniox 延迟调整等级" AutomationProperties.AutomationId="EndpointLatency"/><TextBlock x:Name="EndpointLatencyValue" Style="{StaticResource CaptionTextBlockStyle}"/><ToggleSwitch x:Name="SilenceFallback" Header="启用本地静音兜底" AutomationProperties.AutomationId="SilenceFallback"/><Slider x:Name="SilenceThreshold" Minimum="0.5" Maximum="20" StepFrequency="0.5" AutomationProperties.Name="静音阈值" AutomationProperties.AutomationId="SilenceThreshold"/><TextBlock x:Name="SilenceThresholdValue" Style="{StaticResource CaptionTextBlockStyle}"/><Slider x:Name="SilenceWords" Minimum="1" Maximum="100" StepFrequency="1" AutomationProperties.Name="静音兜底最少词数" AutomationProperties.AutomationId="SilenceWords"/><TextBlock x:Name="SilenceWordsValue" Style="{StaticResource CaptionTextBlockStyle}"/><ToggleSwitch x:Name="LongFallback" Header="启用超长段落兜底" AutomationProperties.AutomationId="LongFallback"/><Slider x:Name="LongWords" Minimum="10" Maximum="1000" StepFrequency="1" AutomationProperties.Name="长段兜底词数门槛" AutomationProperties.AutomationId="LongWords"/><TextBlock x:Name="LongWordsValue" Style="{StaticResource CaptionTextBlockStyle}"/><Slider x:Name="LongDuration" Minimum="5" Maximum="600" StepFrequency="1" AutomationProperties.Name="长段兜底时长门槛" AutomationProperties.AutomationId="LongDuration"/><TextBlock x:Name="LongDurationValue" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Text="修改会在下一次会话生效。静音兜底需同时满足静音时长和词数；长段兜底需同时满足词数和时长。" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Content="恢复默认值" Click="ResetSegmentation_Click" AutomationProperties.AutomationId="ResetSegmentation"/>
     </StackPanel>
     <StackPanel x:Name="ServiceSettingsPage" Spacing="12" Visibility="Collapsed">
      <TextBlock Text="服务密钥" FontWeight="SemiBold"/><PasswordBox x:Name="SonioxKey" Header="Soniox API Key" PlaceholderText="填写 Soniox API Key" AutomationProperties.AutomationId="SonioxKey"/><PasswordBox x:Name="DeepSeekKey" Header="DeepSeek API Key（可选）" PlaceholderText="填写 DeepSeek API Key" AutomationProperties.AutomationId="DeepSeekKey"/><ToggleSwitch x:Name="AutoSummary" Header="停止录音后自动生成总结" AutomationProperties.AutomationId="AutoSummary"/><ToggleSwitch x:Name="AutoCorrection" Header="自动 AI 语境校对（仅生成建议）" AutomationProperties.AutomationId="AutoCorrection"/><TextBlock Text="自动总结和校对会将文字稿发送至 DeepSeek，可能产生费用；不会发送音频。校对只生成建议，需人工确认。" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBox x:Name="CorrectionTerms" Header="校对术语（每行一项）" PlaceholderText="产品名、专业词汇……" AcceptsReturn="True" MinHeight="88" TextWrapping="Wrap" AutomationProperties.AutomationId="CorrectionTerms"/>
     </StackPanel>
    </StackPanel></ScrollViewer>
   </Grid>
   <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.Status, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
  </Grid></Border></Grid>
 </Grid>
</Page>
