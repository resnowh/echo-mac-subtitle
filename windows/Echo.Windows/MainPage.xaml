<Page x:Class="Echo_Windows.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="using:Echo_Windows.Core" xmlns:local="using:Echo_Windows" Background="{ThemeResource EchoCanvasBrush}">
 <Page.Resources>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
  <Style x:Key="SettingCard" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="20"/></Style>
 </Page.Resources>
 <Grid>
  <Grid x:Name="RecordingPanel" Margin="28,12,28,24" RowSpacing="16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <TextBlock Text="ECHO" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource EchoAccentBrush}" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
     <Button Click="Settings_Click" Style="{StaticResource QuietButton}" Width="36" Height="36" Padding="8" ToolTipService.ToolTip="服务设置" AutomationProperties.Name="服务设置" AutomationProperties.AutomationId="SettingsTab"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button>
     <Button Click="CycleTheme_Click" Style="{StaticResource QuietButton}" Width="36" Height="36" Padding="8" ToolTipService.ToolTip="切换浅色、深色或系统主题" AutomationProperties.Name="切换主题" AutomationProperties.AutomationId="CycleTheme"><FontIcon Glyph="&#xE706;" FontSize="16"/></Button>
     <ToggleButton Checked="Topmost_Toggled" Unchecked="Topmost_Toggled" Background="Transparent" BorderThickness="0" Width="36" Height="36" ToolTipService.ToolTip="窗口置顶" AutomationProperties.Name="窗口置顶" AutomationProperties.AutomationId="Topmost"><FontIcon Glyph="&#xE718;" FontSize="16"/></ToggleButton>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="SourceHeading" Text="English" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <TextBlock x:Name="TargetHeading" Grid.Column="1" Text="简体中文" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </Grid>
   <Grid Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
    <TextBlock x:Name="EmptyHint" Text="开始录音后，每条识别结果会保留在这里" VerticalAlignment="Top" Padding="0,14,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <ListView x:Name="TranscriptList" ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}" SelectionMode="None" AutomationProperties.AutomationId="TranscriptList" Padding="0,16,0,24">
     <ListView.ItemTemplate><DataTemplate x:DataType="core:Subtitle">
      <Grid Padding="0,8" RowSpacing="5" ColumnSpacing="14" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{x:Bind Speaker, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="·" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind TimeLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="已纠正" Visibility="{x:Bind local:MainPage.VisibleWhen(HasCorrection), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource EchoAccentBrush}"/></StackPanel>
       <Button Grid.Column="1" Content="{x:Bind CorrectionLabel, Mode=OneWay}" Click="Correction_Click" HorizontalAlignment="Right" Padding="8,2" MinHeight="28" AutomationProperties.Name="纠正字幕" AutomationProperties.AutomationId="EditSubtitle"/>
       <TextBlock Grid.Row="1" Text="{x:Bind English, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
       <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Chinese, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
       <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,6,0,0"/>
      </Grid>
     </DataTemplate></ListView.ItemTemplate>
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
    </ListView>
   </Grid>
   <Grid Grid.Row="3" RowSpacing="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ComboBox x:Name="Mode" SelectedIndex="0" MinWidth="164" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.Name="音频来源" AutomationProperties.AutomationId="InputMode" ToolTipService.ToolTip="音频来源"><x:String>电脑音频</x:String><x:String>麦克风</x:String><x:String>电脑音频 + 麦克风</x:String></ComboBox>
     <Button Grid.Column="1" Click="Start_Click" MinWidth="136" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" Visibility="{x:Bind local:MainPage.HiddenWhen(ViewModel.IsRecording), Mode=OneWay}" Background="{ThemeResource EchoAccentBrush}" Foreground="{ThemeResource EchoAccentForegroundBrush}" AutomationProperties.AutomationId="StartRecording"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE720;" FontSize="14"/><TextBlock Text="开始录音"/></StackPanel></Button>
     <Button Grid.Column="1" Click="Stop_Click" MinWidth="136" IsEnabled="{x:Bind ViewModel.CanStopRecording, Mode=OneWay}" Visibility="{x:Bind local:MainPage.VisibleWhen(ViewModel.IsRecording), Mode=OneWay}" AutomationProperties.AutomationId="StopRecording"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71A;" FontSize="12"/><TextBlock Text="停止录音"/></StackPanel></Button>
     <Button Grid.Column="2" Content="切换设备" Click="SwitchAudio_Click" Visibility="{x:Bind local:MainPage.VisibleWhen(ViewModel.IsRecording), Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanSwitchAudioDevices, Mode=OneWay}" AutomationProperties.AutomationId="SwitchAudioDevice"/>
     <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="360" AutomationProperties.AutomationId="Status"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button Grid.Column="0" AutomationProperties.AutomationId="ArchiveMenu" ToolTipService.ToolTip="选择或管理本地存档"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="14"/><TextBlock x:Name="ArchiveTitle" Text="新的录音" MaxWidth="240" TextTrimming="CharacterEllipsis"/><FontIcon Glyph="&#xE70D;" FontSize="10"/></StackPanel>
       <Button.Flyout><Flyout x:Name="ArchiveFlyout" Placement="TopEdgeAlignedLeft"><Grid Width="300" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="本地存档" Style="{StaticResource SubtitleTextBlockStyle}"/><Button Content="新建" Click="New_Click" HorizontalAlignment="Right" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="Control1"/></Grid><ListView Grid.Row="1" MaxHeight="300" MinHeight="80" ItemsSource="{x:Bind ViewModel.Archives, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedArchive, Mode=TwoWay}" DisplayMemberPath="Title" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="ArchiveList"/><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button Content="重命名" Click="RenameArchive_Click" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="RenameArchive"/><Button Content="导入存档" Click="Import_Click" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="Control2"/><Button Content="数据目录" Click="Folder_Click" AutomationProperties.AutomationId="Control3"/></StackPanel></Grid></Flyout></Button.Flyout>
     </Button>
     <Button Grid.Column="1" Content="导出" AutomationProperties.AutomationId="ExportMenu"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="SRT 字幕" Click="ExportSrt_Click" AutomationProperties.AutomationId="Control5"/><MenuFlyoutItem Text="Echo 存档" Click="ExportArchive_Click" AutomationProperties.AutomationId="Control6"/></MenuFlyout></Button.Flyout></Button>
     <Button Grid.Column="2" Content="更多" AutomationProperties.AutomationId="MoreMenu"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="新建存档" Click="New_Click" AutomationProperties.AutomationId="MoreNew"/><MenuFlyoutItem Text="导入存档" Click="Import_Click" AutomationProperties.AutomationId="MoreImport"/><MenuFlyoutItem Text="拆出刚完成的录音段" Click="SplitSegment_Click" IsEnabled="{x:Bind ViewModel.CanSplitCompletedSegment, Mode=OneWay}" AutomationProperties.AutomationId="SplitCompletedSegment"/><MenuFlyoutItem Text="移入回收区" Click="DeleteArchive_Click" IsEnabled="{x:Bind ViewModel.CanDeleteSelectedArchive, Mode=OneWay}" AutomationProperties.AutomationId="DeleteArchive"/><MenuFlyoutItem Text="打开数据目录" Click="Folder_Click" AutomationProperties.AutomationId="MoreFolder"/></MenuFlyout></Button.Flyout></Button>
     <Button Grid.Column="3" Content="回到最新" Click="Latest_Click" Style="{StaticResource QuietButton}" AutomationProperties.AutomationId="Control4"/>
    </Grid>
    <Grid Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Height="52" Padding="12,0"><StackPanel x:Name="WaveformBars" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="实时音频波形"/></Border>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" MinWidth="112" VerticalAlignment="Center"><Ellipse x:Name="AudioDot" Width="8" Height="8" Fill="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="AudioStatus" Text="未在录音" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
    </Grid>
   </Grid>
   <Expander Grid.Row="4" Header="AI 总结" Visibility="{x:Bind local:MainPage.VisibleWhen(ViewModel.HasEntries), Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" AutomationProperties.AutomationId="Control7"><StackPanel Spacing="12"><StackPanel Orientation="Horizontal" Spacing="8"><ComboBox x:Name="SummaryScope" SelectedIndex="0" AutomationProperties.Name="总结范围" AutomationProperties.AutomationId="Control8"><x:String>新增内容</x:String><x:String>当前录音段</x:String><x:String>整个存档</x:String></ComboBox><Button Content="生成总结" Click="Summary_Click" IsEnabled="{x:Bind local:MainPage.Not(ViewModel.IsSummarizing), Mode=OneWay}" AutomationProperties.AutomationId="Control9"/></StackPanel><ScrollViewer MaxHeight="160"><TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer></StackPanel></Expander>
  </Grid>
  <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="{ThemeResource EchoScrimBrush}" Canvas.ZIndex="10"><Border Width="520" Height="560" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Background="{ThemeResource EchoCanvasBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"><Grid x:Name="SettingsPanel" RowSpacing="16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel Orientation="Horizontal" Spacing="12"><Button Click="Back_Click" Style="{StaticResource QuietButton}" AutomationProperties.Name="返回字幕" AutomationProperties.AutomationId="RecordingTab"><FontIcon Glyph="&#xE72B;" FontSize="16"/></Button><TextBlock Text="设置" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/></StackPanel><Button Content="完成" Click="SaveSettings_Click" Background="{ThemeResource EchoAccentBrush}" Foreground="{ThemeResource EchoAccentForegroundBrush}" HorizontalAlignment="Right" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="SaveSettings"><Button.Resources><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorWindowColor}"/><SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorWindowColor}"/></Button.Resources></Button></Grid>
   <ScrollViewer Grid.Row="1" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"><StackPanel Spacing="16" Padding="0,0,12,8">
    <TextBlock Text="使用你自己的 API Key。密钥加密保存在这台电脑，音频默认不落盘。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
    <Border Style="{StaticResource SettingCard}"><StackPanel Spacing="16"><StackPanel Spacing="4"><TextBlock Text="实时转写与翻译" FontWeight="SemiBold"/><TextBlock Text="Soniox · 录音时发送音频" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><PasswordBox x:Name="SonioxKey" Header="API Key" PlaceholderText="填写 Soniox API Key" AutomationProperties.AutomationId="SonioxKey"/><TextBox x:Name="SonioxModel" Header="实时模型" AutomationProperties.AutomationId="Control10"/><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="SourceLanguage" Header="源语言（留空自动识别）" PlaceholderText="en / zh / ja" AutomationProperties.AutomationId="Control13"/><TextBox Grid.Column="1" x:Name="TargetLanguage" Header="翻译目标语言" PlaceholderText="zh" AutomationProperties.AutomationId="Control14"/></Grid><StackPanel Spacing="8"><ToggleSwitch x:Name="Translate" Header="翻译" AutomationProperties.AutomationId="Control15"/><ToggleSwitch x:Name="Speakers" Header="说话人编号" AutomationProperties.AutomationId="Control16"/><ToggleSwitch x:Name="Strict" Header="严格源语言" AutomationProperties.AutomationId="Control17"/></StackPanel></StackPanel></Border>
    <Border Style="{StaticResource SettingCard}"><StackPanel Spacing="16"><StackPanel Spacing="4"><TextBlock Text="AI 总结与校对" FontWeight="SemiBold"/><TextBlock Text="DeepSeek · 仅在手动请求或开启自动校对时发送文字" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><PasswordBox x:Name="DeepSeekKey" Header="API Key" PlaceholderText="填写 DeepSeek API Key（可选）" AutomationProperties.AutomationId="Control11"/><TextBox x:Name="DeepSeekModel" Header="模型" AutomationProperties.AutomationId="Control12"/><ToggleSwitch x:Name="AutoCorrection" Header="自动 AI 语境校对（仅生成建议）" AutomationProperties.AutomationId="AutoCorrection"/><TextBlock Text="默认关闭。开启后将已分句文字及相邻上下文发送给 DeepSeek，可能产生费用；不发送音频。建议需人工确认，不会自动覆盖字幕。" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBox x:Name="CorrectionTerms" Header="校对术语（每行一项）" PlaceholderText="产品名、专业词汇……" AcceptsReturn="True" MinHeight="88" TextWrapping="Wrap" AutomationProperties.AutomationId="CorrectionTerms"/></StackPanel></Border>
    <Border Style="{StaticResource SettingCard}"><StackPanel Spacing="16"><TextBlock Text="音频与外观" FontWeight="SemiBold"/><ComboBox x:Name="OutputDevice" Header="电脑音频来源" ItemsSource="{x:Bind ViewModel.Outputs, Mode=OneWay}" HorizontalAlignment="Stretch" PlaceholderText="系统默认播放设备" AutomationProperties.AutomationId="Control18"/><ComboBox x:Name="InputDevice" Header="麦克风" ItemsSource="{x:Bind ViewModel.Inputs, Mode=OneWay}" HorizontalAlignment="Stretch" PlaceholderText="系统默认麦克风" AutomationProperties.AutomationId="Control19"/><Button Content="刷新设备" Click="Refresh_Click" AutomationProperties.AutomationId="Control20"/><ComboBox x:Name="ThemeChoice" Header="外观" SelectedIndex="0" AutomationProperties.AutomationId="Control21"><x:String>跟随系统</x:String><x:String>浅色</x:String><x:String>深色</x:String></ComboBox></StackPanel></Border>
   </StackPanel></ScrollViewer>
   <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.Status, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
  </Grid></Border></Grid>
 </Grid>
</Page>
